[Unit]
Description=restic-rest

[Container]
Image=docker.io/restic/rest-server:latest
ContainerName=restic-rest
Network=site
PublishPort=8000:8000
Pull=always
Environment=TZ=${site.env.timezone}
Environment=DATA_DIRECTORY=/data
Environment=PASSWORD_FILE=/auth/htpasswd
Secret=${secrets.restic.htpasswd},type=mount,target=/auth/htpasswd
Volume=${host.env.backup_drive}/restic:/data

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
