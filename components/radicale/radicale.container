[Unit]
Description=radicale

[Container]
Image=docker.io/opencloudeu/radicale:latest
ContainerName=radicale
# No PublishPort. OpenCloud forwards CalDAV here only while this service is placed.
Network=site
Volume=${component.dir}/config:/etc/radicale/config:ro
Volume=${site.data.roots.appdata}/opencloud/radicale:/var/lib/radicale

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
