[Unit]
Description=wg-easy UI (rootless, host netns)
After=network-online.target wireguard-data.service

[Container]
Image=ghcr.io/wg-easy/wg-easy:15
ContainerName=wg-easy
Network=host
Environment=TZ=${site.env.timezone}
Environment=PORT=51821
Environment=INSECURE=true
Environment=DISABLE_IPV6=true
Environment=INIT_ENABLED=true
Environment=INIT_USERNAME=wg-admin
Secret=${secrets.wireguard.ui_password},type=env,target=INIT_PASSWORD
Environment=INIT_HOST=${site.networking.tunnel.endpoint}
Environment=INIT_PORT=51820
Environment=INIT_DNS=${site.networking.ingress.host.ip}
Environment=NAS_LAN_IP=${site.networking.ingress.host.ip}
Volume=${site.data.roots.appdata}/system/wireguard:/etc/wireguard
Volume=${component.dir}/entrypoint.sh:/entrypoint.sh:ro
Volume=${component.dir}/seed-mtu.mjs:/seed-mtu.mjs:ro
Entrypoint=/bin/sh
Exec=/entrypoint.sh

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
