{
	email off
	http_port 8080
	https_port 8443
	# lan-bind is TCP 443→8443. HTTP/3 Alt-Svc would be h3=":8443", so
	# HTTP/3 clients (Firefox) skip DNAT and send Host: name:8443.
	servers {
		protocols h1 h2
	}
	# Edge-only. Do not publish 2019 on the host. CaddyManager and Homepage
	# talk to this API as http://127.0.0.1:2019. GitOps still owns this file.
	admin 0.0.0.0:2019 {
		origins caddy:2019 caddy 127.0.0.1:2019 localhost:2019
	}
}

# Aliases 301 to the Homepage host. OIDC APP_URL / cookies / Authelia
# redirect_uri are single-host; serving the same app on two names breaks login.

(authelia_gate) {
	forward_auth 127.0.0.1:9091 {
		uri /api/authz/forward-auth?authelia_url=https://auth.{$DOMAIN}/
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

#--------------------------------
# AUTHELIA
#--------------------------------

https://authelia.{$DOMAIN} {
	tls internal
	redir https://auth.{$DOMAIN}{uri} permanent
}

https://auth.{$DOMAIN} {
	tls internal
	handle /pki/local-root.crt {
		rewrite * /root.crt
		root * /data/caddy/pki/authorities/local
		file_server
	}
	reverse_proxy 127.0.0.1:9091 {
		header_up Host auth.{$DOMAIN}
		header_up X-Forwarded-Host auth.{$DOMAIN}
		header_up X-Forwarded-Proto https
	}
}
