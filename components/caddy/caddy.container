[Unit]
Description=Caddy (rootless, host netns)
After=network-online.target

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
Network=host
UserNS=keep-id
Environment=DOMAIN=${DOMAIN}
Environment=SURFACE_UPSTREAM=${SURFACE_UPSTREAM}
Environment=TZ=${TZ}
Environment=SITE_NET_GATEWAY=${SITE_NET_GATEWAY}
Volume=${COMPONENT_DIR}/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=${COMPONENT_DIR}/entrypoint.sh:/entrypoint.sh:ro
Volume=${COMPONENT_DIR}/export-ca.sh:/export-ca.sh:ro
Volume=${DATA_ROOT}/system/caddy/data:/data
Volume=${DATA_ROOT}/system/caddy/config:/config
Volume=${DATA_ROOT}/system/authelia:/export-ca
Entrypoint=/bin/sh
Exec=/entrypoint.sh

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
