[Unit]
Description=Caddy (rootless, host netns)
After=network-online.target

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
Network=host
UserNS=keep-id
Environment=DOMAIN=${site.env.domain}
Environment=TZ=${site.env.timezone}
Volume=${component.dir}/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=${component.dir}/entrypoint.sh:/entrypoint.sh:ro
Volume=${component.dir}/export-ca.sh:/export-ca.sh:ro
Volume=${site.data.roots.appdata}/caddy/data:/data
Volume=${site.data.roots.appdata}/caddy/config:/config
Volume=${site.data.roots.appdata}/authelia:/export-ca
Entrypoint=/bin/sh
Exec=/entrypoint.sh

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
