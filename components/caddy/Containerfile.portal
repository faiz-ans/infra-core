# Built when the Authelia portal is styled or Sablier shows a waiting page.
# The catalog unit stays on caddy:2 until one of those is turned on.
FROM docker.io/library/caddy:2-builder AS builder
RUN xcaddy build \
    --with github.com/caddyserver/replace-response \
    --with github.com/sablierapp/sablier-caddy-plugin@v1.0.2

FROM docker.io/library/caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
