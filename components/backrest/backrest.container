[Unit]
Description=backrest

[Container]
Image=ghcr.io/garethgeorge/backrest:latest
ContainerName=backrest
Network=site
PublishPort=127.0.0.1:9898:9898
PublishPort=${host.ip}:9898:9898
Pull=always
Environment=TZ=${site.env.timezone}
Environment=BACKREST_PORT=0.0.0.0:9898
Environment=BACKREST_DATA=/data
Environment=BACKREST_CONFIG=/config/config.json
Environment=BACKREST_RESTIC_COMMAND=/bin/restic
Environment=XDG_CACHE_HOME=/cache
Environment=TMPDIR=/tmp
Environment=BACKUP_HOST=${host.name}
Environment=RESTIC_REPOSITORY=rest:http://${site.hosts.mantle.ip}:8000/${host.name}
Secret=${secrets.restic.password},type=env,target=RESTIC_PASSWORD
Secret=${secrets.restic.rest_password},type=env,target=RESTIC_REST_PASSWORD
Volume=${host.appdata}/backrest/config:/config
Volume=${host.appdata}/backrest/data:/data
Volume=${host.appdata}/backrest/cache:/cache
Volume=${host.appdata}/backrest/tmp:/tmp
Volume=${component.dir}/seed.sh:/seed.sh:ro
Entrypoint=/bin/sh
Exec=/seed.sh

[Service]
Restart=on-failure
TimeoutStopSec=6h

[Install]
WantedBy=default.target
