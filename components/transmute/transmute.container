[Unit]
Description=transmute

[Container]
Image=ghcr.io/transmute-app/transmute:latest
ContainerName=transmute
Network=site
PublishPort=3313:3313
AddDevice=${host.resources.gpu.gpu0.resource}=all
AddHost=auth.${site.env.domain}:${site.networking.ingress.host.ip}
Environment=TZ=${site.env.timezone}
Secret=${secrets.transmute.auth_secret},type=env,target=AUTH_SECRET_KEY
Environment=APP_URL=https://convert.${site.env.domain}
Environment=PORT=3313
Environment=OIDC_ISSUER_URL=https://auth.${site.env.domain}
Environment=OIDC_CLIENT_ID=transmute
Secret=${secrets.authelia.oidc_client_secret},type=env,target=OIDC_CLIENT_SECRET
Environment=NVIDIA_VISIBLE_DEVICES=${host.resources.gpu.gpu0.uuid}
Volume=${host.data.roots.appdata}/transmute:/app/data
Volume=${component.dir}/entrypoint-oidc.sh:/oidc-ca.sh:ro
Volume=${component.dir}/sitecustomize-oidc.py:/oidc-sitecustomize.py:ro
Entrypoint=/bin/bash
Exec=/oidc-ca.sh

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
