apiVersion: v1
kind: Pod
metadata:
  name: seerr
  labels:
    app: seerr
spec:
  restartPolicy: Always
  containers:
  - name: seerr
    image: ghcr.io/seerr-team/seerr:latest
    imagePullPolicy: Always
    env:
    - name: TZ
      value: "{{.TZ}}"
    - name: LOG_LEVEL
      value: "info"
    ports:
    - containerPort: 5055
    volumeMounts:
    - name: config
      mountPath: /app/config

  volumes:
  - name: config
    persistentVolumeClaim:
      claimName: seerr-config
