[Unit]
Description=Redirect host :53/:80/:443 to rootless Pi-hole and Caddy high ports
After=local-fs.target network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
TimeoutStartSec=60
Restart=on-failure
RestartSec=15
ExecStart=/usr/local/sbin/core-lan-bind

[Install]
WantedBy=multi-user.target
