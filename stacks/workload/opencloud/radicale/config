# Radicale behind OpenCloud. Auth is X-Remote-User from the OpenCloud proxy.
# hosts is also passed on the container command: the image CMD binds [::] and
# that exits immediately on an IPv4-only Docker network.
[server]
hosts = 0.0.0.0:5232

[auth]
type = http_x_remote_user

[storage]
predefined_collections = {
 "def-addressbook": {
 "D:displayname": "Personal Address Book",
 "tag": "VADDRESSBOOK"
 },
 "def-calendar": {
 "C:supported-calendar-component-set": "VEVENT,VJOURNAL,VTODO",
 "D:displayname": "Personal Calendar",
 "tag": "VCALENDAR"
 }
 }

[web]
type = none
