{
	email off
}

(authelia_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

https://auth.{$DOMAIN} {
	tls internal
	reverse_proxy authelia:9091
}

https://dash.{$DOMAIN} {
	tls internal
	import authelia_gate
	reverse_proxy homepage:3000
}

https://dns.{$DOMAIN} {
	tls internal
	import authelia_gate
	reverse_proxy pihole:80
}

https://vpn.{$DOMAIN} {
	tls internal
	import authelia_gate
	reverse_proxy wireguard:51821
}

https://ops.{$DOMAIN} {
	tls internal
	# Komodo has its own login. Authelia forward_auth breaks /auth/GetUser
	# (empty login form after sign-in). Direct :9120 stays published on the host.
	reverse_proxy host.docker.internal:9120
}

https://nas.{$DOMAIN} {
	tls internal
	import authelia_gate
	reverse_proxy host.docker.internal:81
}

https://pw.{$DOMAIN} {
	tls internal

	@admin path /admin /admin/*

	handle @admin {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy vaultwarden:80
	}

	handle {
		reverse_proxy vaultwarden:80
	}
}

