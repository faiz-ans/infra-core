#--------------------------------
# HOME ASSISTANT
#--------------------------------

https://ha.{$DOMAIN}, https://homeassistant.{$DOMAIN} {
	tls internal
	redir https://auto.{$DOMAIN}{uri} permanent
}

https://auto.{$DOMAIN} {
	tls internal
	# HA 400s if X-Forwarded-For is present and the TCP peer is not in trusted_proxies.
	# Caddy is on Core, HA is on Docker Desktop: the peer is often an IPv4-mapped
	# address that 0.0.0.0/0 does not match. Do not send For; keep Proto/Host for https.
	reverse_proxy {$HTPC_UPSTREAM}:8123 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up -X-Forwarded-For
	}
}

#--------------------------------
# OPENCLOUD
#--------------------------------

https://oc.{$DOMAIN}, https://opencloud.{$DOMAIN} {
	tls internal
	redir https://cloud.{$DOMAIN}{uri} permanent
}

https://cloud.{$DOMAIN} {
	tls internal
	reverse_proxy opencloud:9200 {
		# Disable buffering for OpenCloud SSE / TUS (nginx equivalent: proxy_buffering off).
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

