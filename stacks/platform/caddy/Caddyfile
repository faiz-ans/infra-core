{
	email off
}

(authelia_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

https://auth.{$DOMAIN}, https://authelia.{$DOMAIN} {
	tls internal
	reverse_proxy authelia:9091
}

https://dash.{$DOMAIN}, https://homepage.{$DOMAIN} {
	tls internal
	reverse_proxy homepage:3000
}

https://gitea.{$DOMAIN} {
	tls internal
	redir https://git.{$DOMAIN}{uri} permanent
}

https://git.{$DOMAIN} {
	tls internal
	reverse_proxy gitea:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

https://dns.{$DOMAIN}, https://pihole.{$DOMAIN} {
	tls internal
	redir / /admin
	reverse_proxy pihole:80
}

https://dns2.{$DOMAIN}, https://pihole2.{$DOMAIN} {
	tls internal
	redir / /admin
	reverse_proxy {$HTPC_UPSTREAM}:8083
}

https://vpn.{$DOMAIN}, https://wg.{$DOMAIN}, https://wireguard.{$DOMAIN} {
	tls internal
	reverse_proxy wireguard:51821
}

https://ops.{$DOMAIN}, https://komodo.{$DOMAIN} {
	tls internal
	reverse_proxy host.docker.internal:9120
}

https://nas.{$DOMAIN}, https://omv.{$DOMAIN}, https://openmediavault.{$DOMAIN} {
	tls internal
	reverse_proxy host.docker.internal:81
}

https://pw.{$DOMAIN}, https://pass.{$DOMAIN}, https://vaultwarden.{$DOMAIN} {
	tls internal

	@admin path /admin /admin/*

	handle @admin {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy vaultwarden:80
	}

	handle {
		reverse_proxy vaultwarden:80
	}
}

https://watch.{$DOMAIN}, https://jellyfin.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:8096
}

https://request.{$DOMAIN}, https://seerr.{$DOMAIN}, https://jellyseerr.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:5055
}

https://auto.{$DOMAIN}, https://ha.{$DOMAIN}, https://homeassistant.{$DOMAIN} {
	tls internal
	# HA 400s if X-Forwarded-For is present and the TCP peer is not in trusted_proxies.
	# Caddy is on Core, HA is on Docker Desktop: the peer is often an IPv4-mapped
	# address that 0.0.0.0/0 does not match. Do not send For; keep Proto/Host for https.
	reverse_proxy {$HTPC_UPSTREAM}:8123 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up -X-Forwarded-For
	}
}

https://cloud.{$DOMAIN}, https://nc.{$DOMAIN}, https://nextcloud.{$DOMAIN} {
	tls internal
	reverse_proxy https://{$HTPC_UPSTREAM}:8080 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

