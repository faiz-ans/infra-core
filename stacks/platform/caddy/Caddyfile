{
	email off
}

(authelia_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

https://auth.{$DOMAIN} {
	tls internal
	reverse_proxy authelia:9091
}

https://dash.{$DOMAIN} {
	tls internal
	reverse_proxy homepage:3000
}

https://dns.{$DOMAIN} {
	tls internal
	redir / /admin
	reverse_proxy pihole:80
}

https://vpn.{$DOMAIN} {
	tls internal
	reverse_proxy wireguard:51821
}

https://ops.{$DOMAIN} {
	tls internal
	reverse_proxy host.docker.internal:9120
}

https://nas.{$DOMAIN} {
	tls internal
	reverse_proxy host.docker.internal:81
}

https://pw.{$DOMAIN} {
	tls internal

	@admin path /admin /admin/*

	handle @admin {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy vaultwarden:80
	}

	handle {
		reverse_proxy vaultwarden:80
	}
}

https://jellyfin.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:8096
}

https://ha.{$DOMAIN} {
	tls internal
	# HA returns 400 if it sees X-Forwarded-For from a peer not in trusted_proxies.
	# Docker Desktop SNATs Caddy, so the NFS configuration.yaml overlay never stuck.
	# Strip the headers; client IP in HA will be the proxy hop.
	reverse_proxy {$HTPC_UPSTREAM}:8123 {
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Proto
		header_up -X-Forwarded-Host
		header_up -Forwarded
	}
}

https://nextcloud.{$DOMAIN} {
	tls internal
	reverse_proxy https://{$HTPC_UPSTREAM}:8080 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

https://sonarr.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:8989
}

https://radarr.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:7878
}

https://prowlarr.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:9696
}

https://qbit.{$DOMAIN}, https://qbittorrent.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:8081 {
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

https://grafana.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:3000
}

https://prometheus.{$DOMAIN} {
	tls internal
	reverse_proxy {$HTPC_UPSTREAM}:9090
}
