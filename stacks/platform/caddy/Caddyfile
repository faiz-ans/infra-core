{
	email off
}

(authelia_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth?authelia_url=https://auth.{$DOMAIN}/
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

https://auth.{$DOMAIN}, https://authelia.{$DOMAIN} {
	tls internal
	handle /pki/local-root.crt {
		rewrite * /root.crt
		root * /data/caddy/pki/authorities/local
		file_server
	}
	reverse_proxy authelia:9091
}

https://dash.{$DOMAIN}, https://homepage.{$DOMAIN} {
	tls internal
	reverse_proxy homepage:3000
}

https://gitea.{$DOMAIN} {
	tls internal
	redir https://git.{$DOMAIN}{uri} permanent
}

https://git.{$DOMAIN} {
	tls internal
	reverse_proxy gitea:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

