{
	email off
}

# Aliases 301 to the Homepage host. OIDC APP_URL / cookies / Authelia
# redirect_uri are single-host; serving the same app on two names breaks login.

(authelia_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth?authelia_url=https://auth.{$DOMAIN}/
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

#--------------------------------
# AUTHELIA
#--------------------------------

https://authelia.{$DOMAIN} {
	tls internal
	redir https://auth.{$DOMAIN}{uri} permanent
}

https://auth.{$DOMAIN} {
	tls internal
	handle /pki/local-root.crt {
		rewrite * /root.crt
		root * /data/caddy/pki/authorities/local
		file_server
	}
	reverse_proxy authelia:9091 {
		header_up Host auth.{$DOMAIN}
		header_up X-Forwarded-Host auth.{$DOMAIN}
		header_up X-Forwarded-Proto https
	}
}
