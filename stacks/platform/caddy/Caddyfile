{
	email off
}

(authelia_gate) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

https://auth.{$DOMAIN}, https://authelia.{$DOMAIN} {
	tls internal
	reverse_proxy authelia:9091
}

https://dash.{$DOMAIN}, https://homepage.{$DOMAIN} {
	tls internal
	reverse_proxy homepage:3000
}

https://dns.{$DOMAIN}, https://pihole.{$DOMAIN} {
	tls internal
	redir / /admin
	reverse_proxy pihole:80
}

https://dns2.{$DOMAIN}, https://pihole2.{$DOMAIN} {
	tls internal
	redir / /admin
	reverse_proxy {$HTPC_UPSTREAM}:8083
}

https://vpn.{$DOMAIN}, https://wireguard.{$DOMAIN} {
