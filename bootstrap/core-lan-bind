#!/usr/bin/env bash
# After reboot, Docker can start before DHCP. Pi-hole publishes
# 127.0.0.1:15353 (always bindable). This unit REDIRECTs ${NAS_LAN_IP}:53
# there once the LAN address exists. Do not bind 0.0.0.0:53 (systemd-resolved).
set -u

DNS_PROXY_PORT=15353

ENV_FILE=/etc/komodo/bootstrap/compose.env

lan_ip() {
  local ip=""
  if [[ -f "${ENV_FILE}" ]]; then
    ip=$(awk -F= '/^NAS_LAN_IP=/{gsub(/["'\'' ]/, "", $2); print $2}' "${ENV_FILE}" | tail -1)
  fi
  if [[ -z "${ip}" ]]; then
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')
  fi
  printf '%s' "${ip}"
}

start_exited_containers() {
  local ids
  ids=$(docker ps -aq --filter status=exited --filter status=created --filter status=dead 2>/dev/null || true)
  if [[ -z "${ids}" ]]; then
    echo "core-lan-bind: no stopped containers"
    return 0
  fi
  echo "core-lan-bind: starting stopped containers"
  # shellcheck disable=SC2086
  docker start ${ids} >/dev/null || true
}

proxy_up() {
  ss -uln 2>/dev/null | grep -q "127.0.0.1:${DNS_PROXY_PORT}" && return 0
  ss -tln 2>/dev/null | grep -q "127.0.0.1:${DNS_PROXY_PORT}" && return 0
  return 1
}

wait_proxy() {
  local i=0
  while [[ "${i}" -lt 30 ]]; do
    if proxy_up; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

del_dns_redirects() {
  local chain line spec n
  for chain in PREROUTING OUTPUT; do
    n=0
    while [[ "${n}" -lt 16 ]]; do
      line=$(iptables -t nat -S "${chain}" 2>/dev/null | grep -- "--to-ports ${DNS_PROXY_PORT}" | head -n 1 || true)
      [[ -z "${line}" ]] && break
      spec=${line#-A ${chain} }
      # shellcheck disable=SC2086
      iptables -t nat -D "${chain}" ${spec} 2>/dev/null || break
      n=$((n + 1))
    done
  done
}

add_dns_redirects() {
  local ip=$1 proto
  for proto in udp tcp; do
    iptables -t nat -A PREROUTING -d "${ip}" -p "${proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PROXY_PORT}"
    iptables -t nat -A OUTPUT -d "${ip}" -p "${proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PROXY_PORT}"
  done
  echo "core-lan-bind: REDIRECT ${ip}:53 -> 127.0.0.1:${DNS_PROXY_PORT}"
}

label() {
  docker inspect -f "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null || true
}

# Recreate so Docker re-publishes 127.0.0.1:15353. Restart keeps dead bindings.
recreate_one() {
  local name=$1
  local wd proj svc files f
  local -a args

  if ! docker inspect "${name}" >/dev/null 2>&1; then
    echo "core-lan-bind: ${name} not present; skip"
    return 0
  fi

  wd=$(label "${name}" com.docker.compose.project.working_dir)
  proj=$(label "${name}" com.docker.compose.project)
  svc=$(label "${name}" com.docker.compose.service)
  files=$(label "${name}" com.docker.compose.project.config_files)

  if [[ -z "${wd}" || -z "${proj}" || -z "${svc}" ]]; then
    echo "core-lan-bind: ${name} has no compose labels; cannot recreate ports."
    docker inspect "${name}" --format 'core-lan-bind: bindings={{json .HostConfig.PortBindings}} status={{.State.Status}} error={{.State.Error}}'
    return 1
  fi

  args=(-p "${proj}" --project-directory "${wd}")
  if [[ -n "${files}" ]]; then
    IFS=',' read -ra flist <<< "${files}"
    for f in "${flist[@]}"; do
      f=${f#"${f%%[![:space:]]*}"}
      f=${f%"${f##*[![:space:]]}"}
      if [[ -n "${f}" && "${f}" != /* ]]; then
        f="${wd}/${f}"
      fi
      if [[ -n "${f}" ]]; then
        args+=(-f "${f}")
      fi
    done
  fi

  echo "core-lan-bind: recreate ${name} (${svc} in ${wd})"
  NAS_LAN_IP="${IP}" docker compose "${args[@]}" up -d --force-recreate --no-deps "${svc}"
}

# DNS REDIRECT does not require bouncing Caddy. Restarting it is what took
# HTTPS down after a successful bind.
ensure_caddy() {
  if ! docker inspect caddy >/dev/null 2>&1; then
    echo "core-lan-bind: caddy not present; skip"
    return 0
  fi
  if docker inspect caddy --format '{{.State.Running}}' 2>/dev/null | grep -q true \
    && ss -tln 2>/dev/null | grep -qE ':443[[:space:]]'; then
    echo "core-lan-bind: caddy already on :443; skip restart"
    return 0
  fi
  echo "core-lan-bind: start/restart caddy"
  docker start caddy >/dev/null 2>&1 || docker restart caddy >/dev/null
}

# Host netns: wg-easy PostUp can leave MASQUERADE on a stale uplink iface.
fix_wg_nat() {
  local cidr=10.8.0.0/24 dev odev extra
  dev=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')
  if [[ -z "${dev}" || "${dev}" == wg* ]]; then
    echo "core-lan-bind: no uplink for WG NAT"
    return 0
  fi
  while read -r line; do
    [[ "${line}" == *MASQUERADE* && "${line}" == *"-s ${cidr}"* ]] || continue
    odev=$(printf '%s\n' "${line}" | sed -n 's/.*-o \([^ ]*\).*/\1/p')
    if [[ -n "${odev}" && "${odev}" != "${dev}" ]]; then
      iptables -t nat -D POSTROUTING -s "${cidr}" -o "${odev}" -j MASQUERADE 2>/dev/null || true
    fi
  done < <(iptables -t nat -S POSTROUTING 2>/dev/null)
  if ! iptables -t nat -S POSTROUTING 2>/dev/null | grep -q -- "-s ${cidr} .*-o ${dev} .*MASQUERADE"; then
    iptables -t nat -A POSTROUTING -s "${cidr}" -o "${dev}" -j MASQUERADE
  fi
  # Collapse duplicate identical rules (seed used to add via nft and iptables).
  extra=0
  while read -r line; do
    [[ "${line}" == *MASQUERADE* && "${line}" == *"-s ${cidr}"* && "${line}" == *"-o ${dev}"* ]] || continue
    extra=$((extra + 1))
    if [[ "${extra}" -gt 1 ]]; then
      iptables -t nat -D POSTROUTING -s "${cidr}" -o "${dev}" -j MASQUERADE 2>/dev/null || true
    fi
  done < <(iptables -t nat -S POSTROUTING 2>/dev/null)
  echo "core-lan-bind: WG MASQUERADE -s ${cidr} -o ${dev}"
}

dump_pihole() {
  echo "core-lan-bind: host IPv4:"
  ip -4 -o addr show | awk '{print "  " $2, $4}'
  if docker inspect pihole >/dev/null 2>&1; then
    docker inspect pihole --format 'core-lan-bind: pihole {{.State.Status}} bindings={{json .HostConfig.PortBindings}} error={{.State.Error}}'
    docker logs pihole --tail 20 2>&1 | sed 's/^/core-lan-bind: pihole log: /'
  fi
}

IP=$(lan_ip)
if [[ -z "${IP}" ]]; then
  echo "core-lan-bind: no NAS_LAN_IP."
  exit 1
fi

# Kick dockerd immediately. Do not REDIRECT until 15353 is listening — an
# early REDIRECT black-holes LAN DNS and blocks failover to the HTPC Pi-hole.
systemctl start --no-block docker.socket docker.service 2>/dev/null || true
echo "core-lan-bind: ${IP}:53 via 127.0.0.1:${DNS_PROXY_PORT} (not 0.0.0.0:53)"

docker_ready=0
started_ct=0
i=0
while [[ "${i}" -lt 150 ]]; do
  if [[ "${docker_ready}" -eq 0 ]] && docker info >/dev/null 2>&1; then
    echo "core-lan-bind: docker is up"
    docker_ready=1
  fi
  if [[ "${docker_ready}" -eq 1 && "${started_ct}" -eq 0 ]]; then
    start_exited_containers
    docker start pihole caddy authelia homepage >/dev/null 2>&1 || true
    started_ct=1
  fi
  if ip -4 addr show | grep -q "inet ${IP}/" && proxy_up; then
    del_dns_redirects
    add_dns_redirects "${IP}"
    ensure_caddy
    fix_wg_nat
    echo "core-lan-bind: done (${IP}:53 -> 127.0.0.1:${DNS_PROXY_PORT})."
    exit 0
  fi
  if [[ $((i % 5)) -eq 0 ]]; then
    echo "core-lan-bind: waiting (docker=${docker_ready} proxy=$(proxy_up && echo 1 || echo 0) addr=$(ip -4 addr show | grep -q "inet ${IP}/" && echo 1 || echo 0))"
  fi
  i=$((i + 1))
  sleep 2
done

if [[ "${docker_ready}" -eq 0 ]]; then
  echo "core-lan-bind: docker is not ready."
  exit 1
fi
if ! ip -4 addr show | grep -q "inet ${IP}/"; then
  echo "core-lan-bind: ${IP} never appeared on a host iface."
  exit 1
fi

echo "core-lan-bind: 127.0.0.1:${DNS_PROXY_PORT} not up; recreate Pi-hole."
if ! recreate_one pihole; then
  dump_pihole
  exit 1
fi
if ! wait_proxy; then
  echo "core-lan-bind: Pi-hole DNS proxy still not published."
  dump_pihole
  exit 1
fi
del_dns_redirects
add_dns_redirects "${IP}"
ensure_caddy
fix_wg_nat
echo "core-lan-bind: done (${IP}:53 -> 127.0.0.1:${DNS_PROXY_PORT})."
exit 0
