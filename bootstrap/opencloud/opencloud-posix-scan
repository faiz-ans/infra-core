#!/usr/bin/env bash
# Assimilate SMB/NFS writes into OpenCloud PosixFS (id cache + xattrs).
# Do not scan /posix (walks uploads/). Do not scan /posix/users (home parent
# has no space xattrs; users/<u>/photos is a Project Space bind).
# Space roots only: users/<u>/files and /posix/projects.
set -euo pipefail

DOCKER="${DOCKER:-/usr/bin/docker}"
LOCK=/run/opencloud-posix-scan.lock
exec 9>"${LOCK}"
if ! flock -n 9; then
  echo "opencloud-posix-scan: already running"
  exit 0
fi

if ! "${DOCKER}" inspect -f '{{.State.Running}}' opencloud 2>/dev/null | grep -qx true; then
  echo "opencloud-posix-scan: container not running"
  exit 0
fi

scan() {
  local path=$1
  echo "opencloud-posix-scan: posixfs scan ${path}"
  "${DOCKER}" exec opencloud opencloud posixfs scan "${path}"
}

while IFS= read -r path; do
  [[ -n "${path}" ]] || continue
  scan "${path}"
done < <("${DOCKER}" exec opencloud sh -c 'ls -d /posix/users/*/files 2>/dev/null' || true)
scan /posix/projects
echo "opencloud-posix-scan: done"
