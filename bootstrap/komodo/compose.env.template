# Placeholder file. core.sh writes /etc/komodo/bootstrap/compose.env on the box.
# Do not put live secrets here.

COMPOSE_KOMODO_IMAGE_TAG=2
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
KOMODO_CORE_CONFIG_TOML=/etc/komodo/core.config.toml

KOMODO_DATABASE_USERNAME=komodo
TZ=America/Los_Angeles

KOMODO_TITLE=Komodo
# core.sh sets KOMODO_HOST=https://ops.${DOMAIN} (Caddy URL). Do not use :9120 here.
KOMODO_LOCAL_AUTH=true
KOMODO_OIDC_ENABLED=false
# core.sh sets KOMODO_OIDC_PROVIDER / CLIENT_ID / CLIENT_SECRET after Authelia exists.
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_FIRST_SERVER_NAME=core
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
# disable_user_registration=true also blocks first Authelia login (new OIDC user).
# Local sign-up stays off; Authelia (admins) is the only way to create users.
KOMODO_DISABLE_USER_REGISTRATION=false
KOMODO_DISABLE_LOCAL_USER_REGISTRATION=true
KOMODO_DISABLE_OIDC_USER_REGISTRATION=false
KOMODO_ENABLE_NEW_USERS=true
KOMODO_RESOURCE_POLL_INTERVAL=15-min

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=core
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
