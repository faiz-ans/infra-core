#!/usr/bin/env bash
# Host nft/iptables: preserve source IPs. Pi-hole and Caddy bind high ports on
# all interfaces (rootless host netns). Do not DNAT to 127.0.0.1.
#
#   :53  -> 15353 (UDP/TCP)
#   :80  -> 8080  (TCP)
#   :443 -> 8443  (TCP+UDP)
#
#   sudo bash bootstrap/core/core-lan-bind.sh
set -u

DNS_PROXY_PORT=15353
HTTP_PORT=8080
HTTPS_PORT=8443
ENV_FILE=/etc/infra-core/site.env

lan_ip() {
  local ip=""
  if [[ -f "${ENV_FILE}" ]]; then
    ip=$(awk -F= '/^NAS_LAN_IP=/{gsub(/["'\'' ]/, "", $2); print $2}' "${ENV_FILE}" | tail -1)
  fi
  if [[ -z "${ip}" ]]; then
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')
  fi
  printf '%s' "${ip}"
}

port_up() {
  local port=$1 proto=${2:-tcp}
  if [[ "${proto}" == udp ]]; then
    ss -uln 2>/dev/null | grep -qE ":${port}[[:space:]]"
  else
    ss -tln 2>/dev/null | grep -qE ":${port}[[:space:]]"
  fi
}

del_nat() {
  local chain line spec n
  for chain in PREROUTING OUTPUT; do
    n=0
    while [[ "${n}" -lt 32 ]]; do
      line=$(iptables -t nat -S "${chain}" 2>/dev/null | grep -E -- "--to-ports (53|80|443|${DNS_PROXY_PORT}|${HTTP_PORT}|${HTTPS_PORT})|--to-destination 127.0.0.1:(53|${DNS_PROXY_PORT})" | head -n 1 || true)
      [[ -z "${line}" ]] && break
      spec=${line#-A ${chain} }
      # shellcheck disable=SC2086
      iptables -t nat -D "${chain}" ${spec} 2>/dev/null || break
      n=$((n + 1))
    done
  done
}

add_redirects() {
  local proto
  # PREROUTING: LAN + WG clients. Do not OUTPUT :53 — that loops host
  # FallbackDNS (1.1.1.1:53) back to an empty Pi-hole and kills apt/git.
  for proto in udp tcp; do
    iptables -t nat -A PREROUTING -p "${proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PROXY_PORT}"
  done
  iptables -t nat -A PREROUTING -p tcp --dport 80 -j REDIRECT --to-ports "${HTTP_PORT}"
  for proto in tcp udp; do
    iptables -t nat -A PREROUTING -p "${proto}" --dport 443 -j REDIRECT --to-ports "${HTTPS_PORT}"
  done
  # Site containers (OpenCloud) cannot PREROUTING-hairpin NAS_LAN_IP:443
  # (connection refused). Pasta maps host.containers.internal 169.254.1.2
  # to 127.0.0.1; OIDC issuer is https://auth.<DOMAIN>:443. Redirect that
  # loopback :443 only. Also cover host-local fetches to NAS_LAN_IP:443.
  for proto in tcp udp; do
    iptables -t nat -A OUTPUT -p "${proto}" -d 127.0.0.1 --dport 443 -j REDIRECT --to-ports "${HTTPS_PORT}"
    iptables -t nat -A OUTPUT -p "${proto}" -d "${IP}" --dport 443 -j REDIRECT --to-ports "${HTTPS_PORT}"
  done
  echo "core-lan-bind: PREROUTING REDIRECT :53->${DNS_PROXY_PORT} :80->${HTTP_PORT} :443->${HTTPS_PORT}"
  echo "core-lan-bind: OUTPUT REDIRECT 127.0.0.1/${IP}:443->${HTTPS_PORT} (site OIDC; not :53)"
}

fix_wg_nat() {
  local cidr=10.8.0.0/24 dev odev extra
  dev=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')
  if [[ -z "${dev}" || "${dev}" == wg* ]]; then
    echo "core-lan-bind: no uplink for WG NAT"
    return 0
  fi
  while read -r line; do
    [[ "${line}" == *MASQUERADE* && "${line}" == *"-s ${cidr}"* ]] || continue
    odev=$(printf '%s\n' "${line}" | sed -n 's/.*-o \([^ ]*\).*/\1/p')
    if [[ -n "${odev}" && "${odev}" != "${dev}" ]]; then
      iptables -t nat -D POSTROUTING -s "${cidr}" -o "${odev}" -j MASQUERADE 2>/dev/null || true
    fi
  done < <(iptables -t nat -S POSTROUTING 2>/dev/null)
  if ! iptables -t nat -S POSTROUTING 2>/dev/null | grep -q -- "-s ${cidr} .*-o ${dev} .*MASQUERADE"; then
    iptables -t nat -A POSTROUTING -s "${cidr}" -o "${dev}" -j MASQUERADE
  fi
  extra=0
  while read -r line; do
    [[ "${line}" == *MASQUERADE* && "${line}" == *"-s ${cidr}"* && "${line}" == *"-o ${dev}"* ]] || continue
    extra=$((extra + 1))
    if [[ "${extra}" -gt 1 ]]; then
      iptables -t nat -D POSTROUTING -s "${cidr}" -o "${dev}" -j MASQUERADE 2>/dev/null || true
    fi
  done < <(iptables -t nat -S POSTROUTING 2>/dev/null)
  if [[ -d /proc/sys/net/ipv4/conf/wg0 ]]; then
    echo 2 >/proc/sys/net/ipv4/conf/wg0/rp_filter 2>/dev/null || true
    iptables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 -i wg0 -j ACCEPT
    iptables -C FORWARD -o wg0 -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 -o wg0 -j ACCEPT
  fi
  echo "core-lan-bind: WG MASQUERADE -s ${cidr} -o ${dev}"
}

IP=$(lan_ip)
if [[ -z "${IP}" ]]; then
  echo "core-lan-bind: no NAS_LAN_IP."
  exit 1
fi

if ! ip -4 addr show | grep -q "inet ${IP}/"; then
  echo "core-lan-bind: ${IP} not on a host iface yet."
  exit 1
fi

del_nat
add_redirects
fix_wg_nat
echo "core-lan-bind: done. Expect Pi-hole on *:${DNS_PROXY_PORT} and Caddy on *: ${HTTP_PORT}/${HTTPS_PORT}."
port_up "${DNS_PROXY_PORT}" udp || echo "core-lan-bind: warn: UDP ${DNS_PROXY_PORT} not listening yet (apply Pi-hole first)."
port_up "${HTTPS_PORT}" tcp || echo "core-lan-bind: warn: TCP ${HTTPS_PORT} not listening yet (apply Caddy first)."
exit 0
